# ToughRADIUS 环境变量配置文件
# 复制此文件为 .env 并根据需要修改配置

# ============================================
# 系统配置
# ============================================
TOUGHRADIUS_SYSTEM_WORKER_DIR=/var/toughradius
TOUGHRADIUS_SYSTEM_DEBUG=true

# ============================================
# Web 服务配置
# ============================================
TOUGHRADIUS_WEB_HOST=0.0.0.0
TOUGHRADIUS_WEB_PORT=1816
# 设为 false 可关闭内置 HTTPS 管理监听
TOUGHRADIUS_WEB_TLS_ENABLED=true
TOUGHRADIUS_WEB_TLS_PORT=1817
# 必须在生产环境改为每个实例唯一的长随机值；该值用于签发管理后台 JWT。
TOUGHRADIUS_WEB_SECRET=change-me-to-a-long-random-string

# ============================================
# 数据库配置
# ============================================
# 数据库类型: sqlite 或 postgres
TOUGHRADIUS_DB_TYPE=sqlite

# SQLite 配置（当 TOUGHRADIUS_DB_TYPE=sqlite 时使用）
TOUGHRADIUS_DB_NAME=toughradius.db

# PostgreSQL 配置（当 TOUGHRADIUS_DB_TYPE=postgres 时使用）
# TOUGHRADIUS_DB_TYPE=postgres
# TOUGHRADIUS_DB_HOST=127.0.0.1
# TOUGHRADIUS_DB_PORT=5432
# TOUGHRADIUS_DB_NAME=toughradius
# TOUGHRADIUS_DB_USER=postgres
# TOUGHRADIUS_DB_PWD=mypassword

TOUGHRADIUS_DB_DEBUG=false

# ============================================
# RADIUS 服务配置
# ============================================
TOUGHRADIUS_RADIUS_ENABLED=true
TOUGHRADIUS_RADIUS_HOST=0.0.0.0
TOUGHRADIUS_RADIUS_AUTHPORT=1812
TOUGHRADIUS_RADIUS_ACCTPORT=1813
TOUGHRADIUS_RADIUS_RADSEC_PORT=2083
TOUGHRADIUS_RADIUS_RADSEC_WORKER=100
TOUGHRADIUS_RADIUS_DEBUG=true

# ============================================
# 日志配置
# ============================================
TOUGHRADIUS_LOGGER_MODE=development
TOUGHRADIUS_LOGGER_FILE_ENABLE=true

# ============================================
# RADIUS 代理 / 漫游 / 动态授权
# 出站到上游 RADIUS / 代拨网关 / 运营商 AAA 统一 PAP（不使用 CHAP/MSCHAPv2）。
# 所有接入类型（IPoE/PPPoE/EAP/Portal Web）经 NAS 送来的认证均可按 realm 路由转换转发；
# 外部代拨网关为独立系统，本项目不实现拨号。
# ============================================
TOUGHRADIUS_RADIUS_PROXY_ENABLED=false
TOUGHRADIUS_RADIUS_PROXY_TIMEOUT=5
TOUGHRADIUS_RADIUS_PROXY_RETRY=2
TOUGHRADIUS_RADIUS_DYNAUTH_ENABLED=false
TOUGHRADIUS_RADIUS_DYNAUTH_PORT=3799
# 入站 CoA/DM 客户端未登记为 upstream 时的回退密钥；生产必须设置
TOUGHRADIUS_RADIUS_DYNAUTH_SECRET=

# ============================================
# Portal V2 协议侧：本项目监听 UDP 50100，报文发往 NAS UDP 2000
# 接入网引流（DHCP/DNS/DHCPv6/Captive）由 NAS 给用户推送，
# Portal Web 登录页 URL 在 NAS 上配置；本项目不托管登录页。
# 下列接入网服务开关仅为边界外参考实现，默认关闭，生产部署不应启用。
# ============================================
TOUGHRADIUS_PORTAL_ENABLED=false
TOUGHRADIUS_PORTAL_BIND_HOST=0.0.0.0
TOUGHRADIUS_PORTAL_BIND_PORT=50100
TOUGHRADIUS_PORTAL_NAS_PORT=2000
TOUGHRADIUS_PORTAL_TIMEOUT=5
TOUGHRADIUS_PORTAL_RETRY=2
TOUGHRADIUS_PORTAL_SESSION_TTL=600

TOUGHRADIUS_CAPTIVE_ENABLED=false
TOUGHRADIUS_CAPTIVE_BIND_ADDR=:80
TOUGHRADIUS_CAPTIVE_LOGIN_PATH=/portal/login
TOUGHRADIUS_CAPTIVE_PORTAL_URL=
# 逗号分隔；防止开放重定向
TOUGHRADIUS_CAPTIVE_WHITELIST=
TOUGHRADIUS_CAPTIVE_AUTHORIZED_TTL=86400

TOUGHRADIUS_DHCP_ENABLED=false
TOUGHRADIUS_DHCP_BIND_ADDR=:67
TOUGHRADIUS_DHCP_SERVER_IP=
TOUGHRADIUS_DHCP_NETWORK=
TOUGHRADIUS_DHCP_GATEWAY=
TOUGHRADIUS_DHCP_DNS=
TOUGHRADIUS_DHCP_START=
TOUGHRADIUS_DHCP_END=
TOUGHRADIUS_DHCP_PORTAL_URL=
TOUGHRADIUS_DHCP_LEASE=3600

TOUGHRADIUS_DNSREDIRECT_ENABLED=false
TOUGHRADIUS_DNSREDIRECT_BIND_ADDR=:53
TOUGHRADIUS_DNSREDIRECT_PORTAL_IP=
TOUGHRADIUS_DNSREDIRECT_UPSTREAM=
TOUGHRADIUS_DNSREDIRECT_WHITELIST=
TOUGHRADIUS_DNSREDIRECT_TTL=0

TOUGHRADIUS_IPV6_ENABLED=false
TOUGHRADIUS_IPV6_BIND_ADDR=:547
TOUGHRADIUS_IPV6_PREFIX=
TOUGHRADIUS_IPV6_DNS=
TOUGHRADIUS_IPV6_PORTAL_URL=
TOUGHRADIUS_IPV6_LEASE=7200

# ============================================
# 开放 API / 支付渠道验签
# ============================================
TOUGHRADIUS_OPENAPI_ENABLED=false
# 格式：AppKey:AppSecret,AppKey2:AppSecret2；生产必须替换
TOUGHRADIUS_OPENAPI_CREDENTIALS=
TOUGHRADIUS_OPENAPI_QPS=20
TOUGHRADIUS_OPENAPI_NONCE_TTL=300
TOUGHRADIUS_OPENAPI_IDEMPOTENCY_TTL=86400

# 生产环境必须设为 true，并只配置实际启用的渠道凭证
TOUGHRADIUS_PAYMENT_ENABLED=false
# wechat | alipay | card
TOUGHRADIUS_PAYMENT_DEFAULT_CHANNEL=
TOUGHRADIUS_PAYMENT_WECHAT_APP_ID=
TOUGHRADIUS_PAYMENT_WECHAT_MCH_ID=
TOUGHRADIUS_PAYMENT_WECHAT_APIV3_KEY=
TOUGHRADIUS_PAYMENT_WECHAT_CERT_PEM=
TOUGHRADIUS_PAYMENT_WECHAT_LEGACY_KEY=
TOUGHRADIUS_PAYMENT_ALIPAY_APP_ID=
TOUGHRADIUS_PAYMENT_ALIPAY_PUBLIC_KEY=
TOUGHRADIUS_PAYMENT_CARD_SECRET=

# ============================================
# 可选共享缓存 / 分析归档
# 显式启用后不可达将直接失败启动，避免多实例幂等状态悄悄降级
# ============================================
TOUGHRADIUS_CACHE_ENABLED=false
TOUGHRADIUS_CACHE_ADDR=
TOUGHRADIUS_CACHE_PASSWORD=
TOUGHRADIUS_CACHE_DB=0
TOUGHRADIUS_CACHE_TTL_SECONDS=300

TOUGHRADIUS_ANALYTICS_ENABLED=false
TOUGHRADIUS_ANALYTICS_DSN=
TOUGHRADIUS_ANALYTICS_BATCH_SIZE=500
TOUGHRADIUS_ANALYTICS_FLUSH_SECONDS=10
